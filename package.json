{
  "name": "dsh-worlds",
  "version": "0.1.0",
  "description": "Run the DeepSeek Harness agent's filesystem, bash and PTY terminals inside a Docker container, so execution state survives a harness restart.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/docker.test.mjs && node test/collect.test.mjs",
    "verify": "node test/live-docker.mjs",
    "verify:fs": "node test/live-fs.mjs",
    "verify:subprocess": "node test/live-subprocess.mjs",
    "verify:terminal": "node test/live-terminal.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "docker",
    "sandbox",
    "execution-world"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frozo-ai/dsh-worlds.git"
  },
  "homepage": "https://github.com/frozo-ai/dsh-worlds#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./adapter/index.ts",
    "./world": "./adapter/world.ts",
    "./fs": "./adapter/fs.ts",
    "./subprocess": "./adapter/subprocess.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "adapter",
    "src",
    "cordis.patch.yml",
    "README.md",
    "SCOPE.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/cordis": "*"
  }
}
